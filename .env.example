# ==============================================================================
# AI-Powered Renewable Generation Forecasting Platform - Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL for enterprise production, SQLite for local testing)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/renewable_db
# SQLite Local Development: DATABASE_URL=sqlite:///./renewable_dev.db

# Security & Cryptographic Tokens
SECRET_KEY=replace_with_a_secure_random_64_char_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Server Settings
PROJECT_NAME="AI-Powered Renewable Generation Forecasting Platform"
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://localhost"]

# External Weather & Satellite Reanalysis Sources
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal

# Real-Time WebSocket Telemetry
WEBSOCKET_TELEMETRY_INTERVAL_SECONDS=1.0
WEBSOCKET_ALERT_SCAN_INTERVAL_SECONDS=5.0

# Automated Retraining & MLOps Drift Gates
RETRAIN_DRIFT_PVALUE_THRESHOLD=0.05
RETRAIN_NMAE_IMPROVEMENT_GATE=0.00
RETRAIN_MAX_WORKERS=2

# CERC DSM Regulatory Settings
CERC_DEFAULT_PERMISSIBLE_ERROR_PCT=10.0
CERC_MODERATE_ERROR_PCT=15.0
CERC_DEFAULT_TARIFF_INR_PER_MWH=3200.0
