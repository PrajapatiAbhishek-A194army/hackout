# Database Configuration (PostgreSQL in production, SQLite fallback for development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/renewable_db

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External Renewable Data & Weather APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal

# Application & CORS
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PROJECT_NAME="AI Renewable Generation Forecasting Platform"
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
PORT=8000
HOST=0.0.0.0
